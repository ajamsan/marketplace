# Kantin Kampus - contoh konfigurasi lingkungan.
# Salin menjadi `.env` lalu isi sendiri. JANGAN commit file .env.
# Semua nilai di bawah kosong; jangan menaruh nilai rahasia di dokumen ini.

# --- Umum ---
APP_ENV=
HTTP_ADDR=
WEB_BASE_URL=
API_BASE_URL=

# --- Frontend (Next.js) ---
NEXT_PUBLIC_TIME_ZONE=
NEXT_PUBLIC_CURRENCY=

# --- Database (PostgreSQL Docker lokal) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
DATABASE_URL=

# --- JWT access token ---
JWT_SIGNING_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
ACCESS_TOKEN_TTL=

# --- Refresh session ---
REFRESH_IDLE_TTL=
REFRESH_ABSOLUTE_TTL=

# --- OTP email ---
OTP_TTL=
OTP_RESEND_COOLDOWN=
OTP_MAX_ROUNDS=
OTP_HASH_KEY=

# --- Mailjet (server-side only) ---
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=

# --- Supabase Storage (service role key HANYA backend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
SIGNED_URL_TTL=

# --- Jaringan & proteksi ---
TRUSTED_PROXY_CIDRS=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=

# --- Upload foto ---
MAX_UPLOAD_BYTES=

# --- QRIS placeholder (default false; true hanya untuk demo terbatas) ---
ALLOW_QRIS_PLACEHOLDER=

# --- Logging & retensi (dev) ---
LOG_LEVEL=
AUDIT_RETENTION_DAYS=

# --- Seed akun demo (DEV ONLY; cmd/seed menolak jalan di production) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_SELLER_EMAIL=
SEED_SELLER_PASSWORD=
SEED_SELLER2_EMAIL=
SEED_BUYER_EMAIL=
SEED_BUYER_PASSWORD=

# --- Testing (jangan diisi untuk menjalankan aplikasi) ---
KANTIN_TEST_DATABASE_URL=
